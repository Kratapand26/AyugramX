using "ui/basic.style";
using "ui/colors.palette";
using "ui/layers/layers.style";
using "ui/widgets/widgets.style";
using "info/info.style";
using "settings/settings.style";

iconPickerSelectedPadding: 2px;
iconPickerSelectedRounding: 12px;
iconPickerImagePadding: 4px;
iconPickerIconSize: 64px;

recentStickersLimitPadding: margins(22px, 4px, 22px, 8px);
imageViewPadding: margins(22px, 10px, 22px, 10px);
imageViewInnerPadding: margins(16px, 16px, 16px, 16px);

botWebViewPanelHeightIncreased: 782px;
botWebViewPanelWidthIncreased: 512px;

stickerRoundingSize: 5px;

messageShotPadding: 4px;

topBarAdmins: IconButton {
	width: 40px;
	height: topBarHeight;

	icon: icon {{ "ayu/top_bar_admins", menuIconFg }};
	iconOver: icon {{ "ayu/top_bar_admins", menuIconFgOver }};
	iconPosition: point(4px, 11px);

	rippleAreaPosition: point(0px, 7px);
	rippleAreaSize: 40px;
	ripple: RippleAnimation(defaultRippleAnimation) {
		color: windowBgOver;
	}
}

topBarRecentActions: IconButton {
	width: 40px;
	height: topBarHeight;

	icon: icon {{ "ayu/top_bar_recent_actions", menuIconFg }};
	iconOver: icon {{ "ayu/top_bar_recent_actions", menuIconFgOver }};
	iconPosition: point(4px, 11px);

	rippleAreaPosition: point(0px, 7px);
	rippleAreaSize: 40px;
	ripple: RippleAnimation(defaultRippleAnimation) {
		color: windowBgOver;
	}
}

exteraBadgeToast: Toast(defaultToast) {
	minWidth: 40px;
	maxWidth: 480px;
	padding: margins(54px, 13px, 19px, 12px);
}

exteraBadgeToastBadge: InfoPeerBadge(infoPeerBadge) {
	premiumFg: toastFg;
}

supportLogoSize: 96px;

unreadPillPadding: 12px;

infoProfileLabeledButtonRegistrationDate: IconButton(defaultIconButton) {
	width: 34px;
	height: 34px;
	icon: icon {{ "menu/calendar", windowActiveTextFg }};
	iconOver: icon {{ "menu/calendar", windowActiveTextFg }};
	rippleAreaPosition: point(0px, 0px);
	rippleAreaSize: 34px;
	ripple: defaultRippleAnimation;
}
registrationDateImportantTooltipLabel: FlatLabel(defaultImportantTooltipLabel) {
	style: TextStyle(defaultTextStyle) {
		font: font(12px);
	}
}

pluginShowInFolderIcon: icon {{ "menu/show_in_folder", boxTitleCloseFg }};
pluginShowInFolderIconOver: icon {{ "menu/show_in_folder", boxTitleCloseFgOver }};
pluginShowInFolder: IconButton(defaultIconButton) {
	width: boxTitleHeight;
	height: boxTitleHeight;

	icon: pluginShowInFolderIcon;
	iconOver: pluginShowInFolderIconOver;

	rippleAreaPosition: point(4px, 4px);
	rippleAreaSize: 40px;
	ripple: defaultRippleAnimationBgOver;
}
maxPluginDescriptionHeight: 400px;
pluginVersionAuthorLabel: FlatLabel(boxLabel) {
    align: align(center);
}
pluginChipSkip: 6px;

ghostPickerArrow: icon{{ "info/edit/expand_arrow_small", windowActiveTextFg }};

ghostPickerButton: LinkButton(defaultLinkButton) {
	color: windowActiveTextFg;
	overColor: windowActiveTextFg;
	font: font(boxFontSize);
	overFont: font(boxFontSize);
}

ayuBetaBadgePadding: margins(4px, 1px, 4px, 1px);

ayuServiceTimeBadgeFont: font(11px semibold);
ayuServiceTimeBadgeHorizontalPadding: 7px;
ayuServiceTimeBadgeVerticalPadding: 2px;
ayuServiceTimeBadgeGap: 8px;
ayuServiceTimeBadgeTrailingInset: 3px;
ayuServiceTimeBadgeLastLineWidthAdd: 9px;

forwarderCompactInputField: InputField(defaultInputField) {
	textMargins: margins(8px, 6px, 8px, 4px);
	placeholderScale: 0.;
	heightMin: 36px;
	heightMax: 36px;
}

// --- Auto-Forwarder redesigned box ---

forwarderBoxWidth: 520px;

forwarderFieldTitle: FlatLabel(defaultFlatLabel) {
	style: TextStyle(defaultTextStyle) {
		font: font(13px semibold);
	}
	textFg: windowBoldFg;
}
forwarderFieldTitlePadding: margins(24px, 10px, 24px, 4px);

forwarderFieldHint: FlatLabel(defaultFlatLabel) {
	align: align(top);
	style: TextStyle(defaultTextStyle) {
		font: font(11px);
	}
	textFg: windowSubTextFg;
}
forwarderFieldHintPadding: margins(24px, 0px, 24px, 0px);

forwarderInputField: InputField(defaultInputField) {
	textMargins: margins(12px, 8px, 12px, 6px);
	placeholderScale: 0.;
	heightMin: 38px;
	heightMax: 38px;
	textBg: windowBgOver;
	textBgActive: windowBgOver;
	border: 0px;
	borderActive: 0px;
	borderRadius: 6px;
}
forwarderMultilineInput: InputField(forwarderInputField) {
	heightMin: 56px;
	heightMax: 100px;
}

chatStickersBoxWidth: 520px;
chatStickersBodyPadding: margins(12px, 8px, 12px, 8px);
chatStickersContextPadding: margins(24px, 0px, 24px, 6px);
chatStickersControlsPadding: margins(24px, 0px, 24px, 8px);
chatStickersContext: FlatLabel(defaultFlatLabel) {
	style: TextStyle(defaultTextStyle) {
		font: font(12px);
	}
	textFg: windowSubTextFg;
	maxHeight: 18px;
}

chatStickersCellWidth: 96px;
chatStickersCellHeight: 120px;
chatStickersPackCellHeight: 144px;
chatStickersPreviewSize: 80px;
chatStickersListHeight: 80px;
chatStickersListPreviewSize: 56px;
chatStickersCellPadding: 8px;
chatStickersCellInset: 3px;
chatStickersCellRadius: 10px;
chatStickersTextGap: 4px;
chatStickersBadgeFont: font(11px semibold);
chatStickersBadgeHeight: 20px;
chatStickersBadgePadding: 8px;
chatStickersBadgeRadius: 10px;
chatStickersToolbarGap: 8px;
chatStickersTabsMinWidth: 160px;
chatStickersSortMaxWidth: 176px;
chatStickersEmptyHeight: 144px;
chatStickersEmptyTextWidth: 280px;
chatStickersEmptyGap: 12px;
chatStickersEmptyIcon: icon {{ "menu/stickers", windowSubTextFg }};
chatStickersPlaceholderFont: font(24px);

chatStickersTabs: SettingsSlider(defaultTabsSlider) {
	height: 40px;
	barTop: 37px;
}
chatStickersSort: RoundButton(defaultLightButton) {
	height: 32px;
	width: -20px;
	radius: 16px;
	textTop: 7px;
	textBg: windowBgOver;
	icon: icon {{ "info/edit/expand_arrow_small", lightButtonFg }};
	iconOver: icon {{ "info/edit/expand_arrow_small", lightButtonFgOver }};
	iconPosition: point(-6px, 13px);
	style: TextStyle(defaultTextStyle) {
		font: font(12px);
	}
}
chatStickersViewButton: IconButton(defaultIconButton) {
	width: 32px;
	height: 32px;
	rippleAreaPosition: point(0px, 0px);
	rippleAreaSize: 32px;
	ripple: defaultRippleAnimation;
}
chatStickersGrid: IconButton(chatStickersViewButton) {
	icon: icon {{ "ayu/chat_stickers_grid", windowSubTextFg }};
	iconOver: icon {{ "ayu/chat_stickers_grid", windowFg }};
}
chatStickersList: IconButton(chatStickersViewButton) {
	icon: icon {{ "ayu/chat_stickers_list", windowSubTextFg }};
	iconOver: icon {{ "ayu/chat_stickers_list", windowFg }};
}
chatStickersBoxInfo: IconButton(boxTitleClose) {
	iconPosition: point(-1px, 13px);
	icon: icon {{ "menu/info", boxTitleCloseFg }};
	iconOver: icon {{ "menu/info", boxTitleCloseFgOver }};
}

chatStickersSearchInput: InputField(defaultInputField) {
	textMargins: margins(36px, 10px, 40px, 8px);
	placeholderScale: 0.;
	heightMin: 40px;
	heightMax: 40px;
	textBg: windowBgOver;
	textBgActive: windowBgOver;
	border: 0px;
	borderActive: 0px;
	borderRadius: 20px;
}
chatStickersSearchIcon: IconButton(defaultIconButton) {
	width: 36px;
	height: 40px;
	icon: icon {{ "box_search", windowSubTextFg }};
	iconOver: icon {{ "box_search", windowSubTextFg }};
}
chatStickersSearchClear: IconButton(chatStickersSearchIcon) {
	icon: boxTitleCloseIcon;
	iconOver: boxTitleCloseIconOver;
}

chatStickersStatusPadding: margins(24px, 4px, 24px, 0px);
chatStickersStatusFont: font(12px);
chatStickersStatusHeight: 28px;
chatStickersLoading: InfiniteRadialAnimation(boxLoadingAnimation) {
	size: size(16px, 16px);
}

localChannelsFolderHeaderHeight: 48px;
localChannelsFolderPadding: 12px;
localChannelsFolderManage: IconButton(defaultIconButton) {
	width: 40px;
	height: 40px;
	icon: icon {{ "menu/settings", windowSubTextFg }};
	iconOver: icon {{ "menu/settings", windowFg }};
	rippleAreaPosition: point(0px, 0px);
	rippleAreaSize: 40px;
	ripple: defaultRippleAnimation;
}
localChannelsBoxInfo: IconButton(boxTitleClose) {
	iconPosition: point(-1px, 13px);
	rippleAreaPosition: point(4px, 5px);
	icon: icon {{ "menu/info", boxTitleCloseFg }};
	iconOver: icon {{ "menu/info", boxTitleCloseFgOver }};
}
